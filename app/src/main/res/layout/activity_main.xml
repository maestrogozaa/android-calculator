<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    tools:context=".MainActivity">


    <!-- PANTALLA RESULTADO -->

    <TextView
        android:id="@+id/pantallaResultado"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="#111827"
        android:elevation="4dp"
        android:fontFamily="sans"
        android:gravity="end|center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- GRADOS / RADIANES -->

    <Switch
        android:id="@+id/switchGrados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="DEG"
        android:textColor="#374151"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pantallaResultado"
        tools:ignore="UseSwitchCompatOrMaterialXml" />


    <!-- AC -->

    <Button
        android:id="@+id/botonAC"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#DC2626"
        android:elevation="2dp"
        android:text="AC"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switchGrados" />


    <!-- TRIGONOMETRÍA -->

    <Button
        android:id="@+id/botonSin"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#E0E7FF"
        android:elevation="2dp"
        android:text="SIN"
        android:textColor="#3730A3"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/botonAC"
        app:layout_constraintTop_toTopOf="@id/botonAC" />

    <Button
        android:id="@+id/botonCos"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#E0E7FF"
        android:elevation="2dp"
        android:text="COS"
        android:textColor="#3730A3"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/botonSin"
        app:layout_constraintTop_toTopOf="@id/botonAC" />

    <Button
        android:id="@+id/botonTan"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#E0E7FF"
        android:elevation="2dp"
        android:text="TAN"
        android:textColor="#3730A3"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/botonCos"
        app:layout_constraintTop_toTopOf="@id/botonAC" />


    <!-- 7 8 9 ÷ -->

    <Button
        android:id="@+id/boton7"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="7"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/botonAC"
        app:layout_constraintTop_toBottomOf="@id/botonAC" />

    <Button
        android:id="@+id/boton8"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="8"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton7"
        app:layout_constraintTop_toTopOf="@id/boton7" />

    <Button
        android:id="@+id/boton9"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="9"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton8"
        app:layout_constraintTop_toTopOf="@id/boton7" />

    <Button
        android:id="@+id/botonDividir"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#2563EB"
        android:elevation="2dp"
        android:text="÷"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton9"
        app:layout_constraintTop_toTopOf="@id/boton7" />


    <!-- 4 5 6 × -->

    <Button
        android:id="@+id/boton4"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="4"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/boton7"
        app:layout_constraintTop_toBottomOf="@id/boton7" />

    <Button
        android:id="@+id/boton5"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="5"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton4"
        app:layout_constraintTop_toTopOf="@id/boton4" />

    <Button
        android:id="@+id/boton6"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="6"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton5"
        app:layout_constraintTop_toTopOf="@id/boton4" />

    <Button
        android:id="@+id/botonMultiplicar"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#2563EB"
        android:elevation="2dp"
        android:text="×"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton6"
        app:layout_constraintTop_toTopOf="@id/boton4" />


    <!-- 1 2 3 - -->

    <Button
        android:id="@+id/boton1"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="1"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/boton4"
        app:layout_constraintTop_toBottomOf="@id/boton4" />

    <Button
        android:id="@+id/boton2"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="2"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton1"
        app:layout_constraintTop_toTopOf="@id/boton1" />

    <Button
        android:id="@+id/boton3"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="3"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton2"
        app:layout_constraintTop_toTopOf="@id/boton1" />

    <Button
        android:id="@+id/botonRestar"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#2563EB"
        android:elevation="2dp"
        android:text="-"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton3"
        app:layout_constraintTop_toTopOf="@id/boton1" />


    <!-- 0 = + -->

    <Button
        android:id="@+id/boton0"
        android:layout_width="152dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp"
        android:text="0"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/boton1"
        app:layout_constraintTop_toBottomOf="@id/boton1" />

    <Button
        android:id="@+id/botonCalcular"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#16A34A"
        android:elevation="2dp"
        android:text="="
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/boton0"
        app:layout_constraintTop_toTopOf="@id/boton0" />

    <Button
        android:id="@+id/botonSumar"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#2563EB"
        android:elevation="2dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/botonCalcular"
        app:layout_constraintTop_toTopOf="@id/boton0" />


</androidx.constraintlayout.widget.ConstraintLayout>